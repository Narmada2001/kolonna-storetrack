# MySQL connection. Example: mysql+pymysql://root:password@localhost:3306/kolonna_storetrack
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/kolonna_storetrack

# JWT signing secret - change this in production
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Default admin account created by seed.py
DEFAULT_ADMIN_EMAIL=admin@kolonna.lk
DEFAULT_ADMIN_PASSWORD=Admin@123
